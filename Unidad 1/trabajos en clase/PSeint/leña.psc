Algoritmo leña
    Definir num, sum, result, result2 Como Entero
    
    Escribir "introduzca el numero de carros de leña: "
    Leer num
    
    sum <- num * 100000
    result <- sum / 5
    result2 <- result * 4
    
    Escribir "total de produccion:", result2
    Escribir "ganancia de los ", num, " carros de leña:", result
FinAlgoritmo
