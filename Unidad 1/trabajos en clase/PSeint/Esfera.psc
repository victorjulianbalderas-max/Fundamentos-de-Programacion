Algoritmo Esfera
	Definir radio, area, volumen Como Real
	Escribir "Ingrese el radio: "
	Leer radio
	
	area <- 4 * PI * (radio * radio)
	volumen <- (4 * PI * (radio * radio * radio)) / 3
	
	Escribir "El area de la esfera es: ", area
	Escribir "El volumen de la esfera es: ", volumen
FinAlgoritmo